@model AirQualityAnalysis.Controllers.AirQualityRecordsController.CityRecordsViewModel

@{
    ViewBag.Title = "City Records";
    var userRole = Session["UserRole"] as string;
    bool isAdmin = userRole == "Admin";
}

<h3>City Records</h3>

@if (Model.CityInfo == null)
{
    <p>Loading...</p>
}
else
{
    <div style="margin-bottom:15px;">
        <a href="@Url.Action("Index", "AirQualityRecords", new { countryId = Model.CountryId, cityId = Model.SelectedCityId, pollutantId = Model.PollutantId, page = Model.Page })"
           class="btn btn-secondary">
            Back to Records
        </a>
    </div>

    <div style="margin-bottom:15px;">
        <strong>Country:</strong> @Model.CityInfo.CountryName <br />
        <strong>City:</strong> @Model.CityInfo.CityName
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Record ID</th>
                <th>Pollutant</th>
                <th>Category</th>
                <th>AQI Value</th>
                <th>Last Updated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Rows)
            {
                <tr>
                    <td>@(item.RecordID.HasValue ? item.RecordID.ToString() : "—")</td>
                    <td>@item.PollutantName</td>
                    <td>@(string.IsNullOrEmpty(item.CategoryName) ? "—" : item.CategoryName)</td>
                    <td>@(item.AQIValue.HasValue ? item.AQIValue.ToString() : "—")</td>
                    <td>@(item.LastUpdated.HasValue ? item.LastUpdated.ToString() : "—")</td>
                    <td>
                        @if (!isAdmin)
                        {
                            <span style="color:gray;">View Only</span>
                        }
                        else if (item.PollutantName == "Overall AQI")
                        {
                            <span style="color:gray;">Auto Calculated</span>
                        }
                        else if (item.RecordID.HasValue)
                        {
                            <a href="@Url.Action("Edit", "AirQualityRecords", new {
                                id = item.RecordID.Value,
                                countryId = Model.CountryId,
                                cityId = Model.CityInfo.CityID,
                                pollutantId = Model.PollutantId,
                                page = Model.Page
                            })" class="btn btn-sm btn-primary">Edit</a>

                            <a href="@Url.Action("Delete", "AirQualityRecords", new {
                                id = item.RecordID.Value,
                                countryId = Model.CountryId,
                                cityId = Model.CityInfo.CityID,
                                pollutantId = Model.PollutantId,
                                page = Model.Page
                            })" class="btn btn-sm btn-danger">Delete</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Add", "AirQualityRecords", new {
                                returnCityId = item.CityID,
                                pollutantToAddId = item.PollutantID,
                                countryId = Model.CountryId,
                                cityId = Model.SelectedCityId,
                                pollutantId = Model.PollutantId,
                                page = Model.Page
                            })" class="btn btn-sm btn-success">Add</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}