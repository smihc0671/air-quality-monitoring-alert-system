@model AirQualityAnalysis.City

@{
    ViewBag.Title = "Delete City";
}

<h3>Delete City</h3>

@if (Model == null)
{
    <p>Loading...</p>
}
else
{
    <p>Are you sure you want to delete this city?</p>

    <ul>
        <li><b>City ID:</b> @Model.CityID</li>
        <li><b>City Name:</b> @Model.CityName</li>
        <li><b>Country:</b> @ViewBag.CountryName</li>
    </ul>

    using (Html.BeginForm("Delete", "Cities", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CityID)

        <input type="submit" value="Delete" class="btn btn-danger me-2" />
        <a href="@Url.Action("Index", "Cities")" class="btn btn-secondary">Cancel</a>
    }

    if (ViewBag.ErrorMessage != null)
    {
        <p style="color:red; margin-top:15px;">@ViewBag.ErrorMessage</p>
    }
}